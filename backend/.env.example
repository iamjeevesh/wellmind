# ============================================
# WellMind Backend — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to Git!
# ============================================

# Database (PostgreSQL)
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:jeevesh1856@localhost:5432/wellmind

# OpenAI API (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Security — make this a long random string (32+ characters)
SECRET_KEY=change-this-to-a-very-long-random-secret-key-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Clerk Authentication (get from https://clerk.com dashboard)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# App Settings
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
APP_NAME=WellMind
